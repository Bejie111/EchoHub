@model IEnumerable<EchoHub.Models.Collection>

@{
    ViewData["Title"] = "Collection Management";
    var pending = ViewBag.PendingItems as List<EchoHub.Models.EwasteItem>;
}

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<h2>Collection Management</h2>

<hr />

<h4>Pending Collections</h4>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Item Name</th>
            <th>Category</th>
            <th>Client</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (pending != null && pending.Count > 0)
        {
            foreach (var item in pending)
            {
                <tr>
                    <td>@item.Item_Name</td>
                    <td>@item.Category</td>
                    <td>@item.User?.Name</td>
                    <td>
                        <a asp-action="Assign"
                               asp-route-id="@item.EwasteId"
                               class="btn btn-success btn-sm">
                            Assign Collection
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">No Pending Collections</td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h4>Scheduled Collections</h4>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Item</th>
            <th>Client</th>
            <th>Assigned Staff</th>
            <th>Schedule Date</th>
            <th>Status</th>
            <th>Collection Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EwasteItem?.Item_Name</td>
                <td>@item.EwasteItem?.User?.Name</td>
                <td>@item.Staff?.Name</td>
                <td>@item.ScheduleDate.ToString("MMMM dd, yyyy")</td>
                <td>@item.Status</td>
                <td>
                    @(item.CollectionDate.HasValue
                        ? item.CollectionDate.Value.ToString("MMMM dd, yyyy hh:mm tt")
                        : "Not Yet")
                </td>
                <td>
                    <a asp-action="MarkCollected"
                           asp-route-id="@item.CollectionId"
                           class="btn btn-primary btn-sm">
                        Mark Collected
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>