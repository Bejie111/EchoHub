
@{
    ViewData["Title"] = "MySubmission";
}

@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
@model IEnumerable<EchoHub.Models.EwasteItem>

<link rel="stylesheet" href="~/css/userpages.css" />

<div class="container-box">

    <div class="top-line">

        <h2>My Submissions</h2>

        <form method="get" asp-action="MySubmission">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search..." />
            <button type="submit">Search</button>
        </form>

    </div>

    <table>

        <thead>
            <tr>
                <th>Item Name</th>
                <th>Category</th>
                <th>Status</th>
                <th>Date Submitted</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Item_Name</td>
                    <td>@item.Category</td>
                    <td>@item.Status</td>
                    <td>@item.DateSubmitted.ToString("MMM dd, yyyy")</td>
                </tr>
            }
        </tbody>

    </table>

</div>

