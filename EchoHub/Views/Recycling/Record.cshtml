@{
    ViewData["Title"] = "Record Recycling";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}
<!--HEADER-->
<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="header-container mb-4 p-4 rounded-4 shadow-sm position-relative overflow-hidden"
         style="background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%); border: 1px solid #e2e8f0;">

        <i class="bi bi-shield-check position-absolute text-success opacity-10"
           style="font-size: 8rem; right: -20px; top: -20px; transform: rotate(15deg); pointer-events: none;"></i>

        <div class="position-relative">
            <div class="d-flex align-items-center gap-3">
                <div class="shadow-sm" style="background: #27ae60; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-clipboard-data text-white fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.5px;">Record Recycling</h2>
                    <p class="text-muted mb-0 small d-flex align-items-center">
                        <i class="bi bi-info-circle me-1"></i> Select item and record its recycling result.
                    </p>
                </div>
            </div>
        </div>
    </div>

<!--INPUT RECYCLING RECORD-->
    <div class="card form-card">
        <form asp-action="Record" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- SELECT ITEM -->
            <div class="form-group">
                <label>Select Item</label>

                <select name="EwasteId" class="form-control">
                    <option value="">-- Choose Item --</option>
                    @foreach (var item in ViewBag.ItemList)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <!-- SELECT STATUS -->
            <div class="form-group">
                <label>Status</label>

                <select name="Status" class="form-control">
                    <option value="">-- Choose Status --</option>
                    <option value="Recycled">Recycled</option>
                    <option value="Disposed">Disposed</option>
                </select>
            </div>

            <!-- BUTTONS -->
            <div class="btn-row">
                <button type="submit" class="btn-green">
                    Save Record
                </button>

                <a asp-action="Dashboard" class="btn-light">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

