@model EchoHub.Models.Collection

@{
    ViewData["Title"] = "Assign Collection";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="assign-page">

    <!-- Header -->
    <div class="assign-header">
        <h2>Assign Collection</h2>
        <p>Schedule pickup and assign staff for the selected e-waste item.</p>
    </div>

    <!-- Card -->
    <div class="assign-card">

        <form asp-action="Assign" method="post">

            @Html.AntiForgeryToken()

            <!-- Hidden -->
            <input type="hidden" asp-for="EwasteId" value="@ViewBag.EwasteId" />

            <!-- Item Name -->
            <div class="form-group">
                <label>Item Name</label>
                <input type="text"
                       class="form-control"
                       value="@ViewBag.ItemName"
                       readonly />
            </div>

            <!-- Staff -->
            <div class="form-group">
                <label>Select Staff</label>

                <select asp-for="StaffId"
                        asp-items="ViewBag.StaffList"
                        class="form-control">
                    <option value="">-- Choose Staff --</option>
                </select>

                <span asp-validation-for="StaffId" class="text-danger"></span>
            </div>

            <!-- Schedule -->
            <div class="form-group">
                <label>Schedule Date</label>

                <input asp-for="ScheduleDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ScheduleDate" class="text-danger"></span>
            </div>

            <!-- Buttons -->
            <div class="btn-row">

                <button type="submit" class="btn-green">
                    Save Assignment
                </button>

                <a asp-action="Collect"
                   class="btn-light">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>