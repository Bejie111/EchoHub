@{
    ViewData["Title"] = "_StaffLayout";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Staff Panel</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <!-- Your CSS -->
    <link rel="stylesheet" href="~/css/staff.css" />
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="bg-white border-end vh-100 p-3" style="width: 250px;">

            <h5 class="fw-bold mb-4">
                <i class="bi bi-recycle text-success"></i> E-Waste
            </h5>

            <ul class="nav flex-column">

                <li class="nav-item mb-2">
                    <a class="nav-link text-dark" href="/Staff/Dashboard">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-dark" href="/Staff/Manage">
                        <i class="bi bi-box me-2"></i> Manage E-Waste
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-dark" href="/Collection/Collect">
                        <i class="bi bi-truck me-2"></i> Collections
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-dark" href="/Recycling/Index">
                        <i class="bi bi-arrow-repeat me-2"></i> Recycling
                    </a>
                </li>

                <li class="nav-item mt-4">
                    <a class="nav-link text-danger" href="/Account/Login">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </a>
                </li>

            </ul>

        </div>

        <!-- Main Content -->
        <div class="flex-grow-1">

            <!-- Top Navbar -->
            <div class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center">

                <span class="fw-semibold">Staff Panel</span>

                <div>
                    <span class="me-3 text-muted">
                        <i class="bi bi-bell"></i>
                    </span>

                    <span class="badge bg-success">
                        Staff Member
                    </span>
                </div>

            </div>

            <!-- Page Content -->
            <div class="p-4 bg-light min-vh-100">
                @RenderBody()
            </div>

        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>