@model IEnumerable<EchoHub.Models.EwasteItem>

@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<link rel="stylesheet" href="~/css/userdashboard.css" />

<div class="container mt-4">

    <h2 class="mb-1">Dashboard</h2>
    <p class="text-muted">Welcome back! Here's your e-waste overview'</p>

    <!-- Cards -->
    <div class="row g-3 mt-3">

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Submission</h6>
                    <h3>@ViewBag.TotalSubmission</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Items Recycled</h6>
                    <h3>@ViewBag.Recycled</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Items Pending</h6>
                    <h3>@ViewBag.Pending</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Items</h6>
                    <h3>@ViewBag.TotalItems</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card mt-4 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Quick Actions</h5>
            <a href="/User/Submit" class="btn btn-success">
                + Submit New Item
            </a>
        </div>
    </div>

    <!-- Recent Submissions -->
    <div class="card mt-4 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between mb-3">
                <h5>Recent Submissions</h5>
                <a href="/User/MySubmission" class="btn btn-outline-primary btn-sm">
                    View All
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Item Name</th>
                            <th>Status</th>
                            <th>Date Submitted</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Take(5))
                        {
                            <tr>
                                <td>@item.Item_Name</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.DateSubmitted.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>