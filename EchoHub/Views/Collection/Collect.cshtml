@model IEnumerable<EchoHub.Models.Collection>

@{
    ViewData["Title"] = "Collection Management";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";

    var pending = ViewBag.PendingItems as List<EchoHub.Models.EwasteItem>;
}

<div class="page-wrapper">

    <!-- Header -->
    <div class="page-header">
        <h2>Collection Management</h2>
        <p>Assign and track e-waste collection schedules.</p>
    </div>

    <!-- ================================ -->
    <!-- Pending Collections Card -->
    <!-- ================================ -->
    <div class="card-box">

        <div class="card-top">
            <h4>Pending Collections</h4>

            <a asp-action="Collect" class="btn-green">
                Refresh
            </a>
        </div>

        <div class="collection-list">

            @if (pending != null && pending.Count > 0)
            {
                foreach (var item in pending)
                {
                    <div class="collection-row">

                        <div class="left-info">
                            <h5>@item.Item_Name</h5>
                            <span>
                                @item.Category •
                                @item.User?.Name
                            </span>
                        </div>

                        <div class="right-action">

                            <span class="badge-yellow">Pending</span>

                            <a asp-controller="Collection"
                                   asp-action="Assign"
                                   asp-route-id="@item.EwasteId"
                                   class="btn-green btn-sm">
                                Schedule Collection
                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-box">
                    No Pending Collections
                </div>
            }

        </div>

    </div>

    <!-- ================================ -->
    <!-- Scheduled Collections -->
    <!-- ================================ -->
    <div class="card-box mt-4">

        <h4>Scheduled Collections</h4>

        <div class="collection-list mt-3">

            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="collection-row">

                        <div class="left-info">
                            <h5>
                                @(item.ScheduleDate.HasValue ? item.ScheduleDate.Value.ToString("yyyy-MM-dd") : "N/A")
                            </h5>

                            <span>
                                @item.EwasteItem?.Item_Name •
                                @item.EwasteItem?.User.Name •
                                @item.EwasteItem?.Address
                            </span>
                        </div>

                        <div class="right-action">

                            @if (item.Status == "Scheduled")
                            {
                                <span class="badge-blue">Scheduled</span>

                                <a asp-action="MarkCollected"
                                       asp-route-id="@item.CollectionId"
                                       class="btn-primary btn-sm">
                                    Mark Collected
                                </a>
                            }
                            else
                            {
                                <span class="badge-green">Completed</span>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-box">
                    No Scheduled Collections
                </div>
            }

        </div>

    </div>

    <!-- ================================ -->
    <!-- Bottom Stats -->
    <!-- ================================ -->
    <div class="stats-grid">

        <div class="stat-card">
            <small>Today's Collections</small>
            <h2>@Model.Count(x => x.ScheduleDate.HasValue && x.ScheduleDate.Value.Date == DateTime.Today)</h2>
            <span>Scheduled Today</span>
        </div>

        <div class="stat-card">
            <small>This Week</small>
            <h2>@Model.Count(x => x.ScheduleDate >= DateTime.Today.AddDays(-7))</h2>
            <span>Total This Week</span>
        </div>

        <div class="stat-card">
            <small>Success Rate</small>

            @{
                var total = Model.Count();
                var done = Model.Count(x => x.Status == "Completed");
                var rate = total == 0 ? 0 : (done * 100) / total;
            }

            <h2>@rate%</h2>
            <span>On-time Collections</span>
        </div>

    </div>

</div>