@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var percent = ViewBag.Percent ?? 0;
}

<!-- Header -->
<div class="submit-header">
    <h2>Admin Dashboard</h2>
    <p>System overview and analytics.</p>
</div>

<!-- Stats Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-label">Total Users</span>
            <span class="stat-value">@ViewBag.TotalUsers</span>
            <span class="text-success small">
                +@percent.ToString("0.#")% from last month
            </span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-label">Total E-Waste Items</span>
            <span class="stat-value">@ViewBag.TotalItems</span>
            <span class="text-success small">
                +@percent.ToString("0.#")% from last month
            </span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-label">Items Recycled</span>
            <span class="stat-value">@ViewBag.TotalRecycled</span>
            <span class="text-success small">
                +@percent.ToString("0.#")% success rate
            </span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span class="stat-label">Items Disposed</span>
            <span class="stat-value">@ViewBag.TotalDisposed</span>
            <span class="text-success small">
                +@percent.ToString("0.#")% of total
            </span>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="charts-grid">
    <div class="section-card">
        <div class="section-title">Monthly Submissions Trend</div>
        <canvas id="lineChart"></canvas>
    </div>

    <div class="section-card">
        <div class="section-title">E-Waste by Category</div>
        <canvas id="pieChart"></canvas>
    </div>
</div>

<div class="section-card">
    <div class="section-title">Recycling Performance</div>
    <canvas id="barChart"></canvas>
</div>

<!-- Recent Users -->
<div class="section-card">
    <div class="section-title">Recent User Registrations</div>

    @if (ViewBag.RecentUsers != null)
    {
        foreach (var user in ViewBag.RecentUsers)
        {
            <div>
                <strong>@user.Name</strong> - @user.Email (@user.Role)
            </div>
        }
    }
    else
    {
        <p>No recent registrations.</p>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const submissions = @Html.Raw(ViewBag.MonthlySubmissions ?? "[0,0,0,0,0,0]");
        const recycled = @Html.Raw(ViewBag.MonthlyRecycled ?? "[0,0,0,0,0,0]");
        const disposed = @Html.Raw(ViewBag.MonthlyDisposed ?? "[0,0,0,0,0,0]");

        // LINE CHART
        new Chart(document.getElementById('lineChart'), {
        type: 'line',
        data: {
        labels: ['Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'],
        datasets: [
        { label: 'Submissions', data: submissions },
        { label: 'Recycled', data: recycled },
        { label: 'Disposed', data: disposed }
        ]
        }
        });

        // PIE CHART
        new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
        labels: @Html.Raw(ViewBag.CategoryLabels ?? "['Laptops','Phones','Others']"),
        datasets: [{
        data: @Html.Raw(ViewBag.CategoryData ?? "[30,20,50]")
        }
        ]
        }
        });

        // BAR CHART
        new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
        labels: ['Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'],
        datasets: [
        { label: 'Recycled', data: recycled },
        { label: 'Disposed', data: disposed }
        ]
        }
        });
    </script>
}