@{
    var currentPage = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>User Panel</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <!-- Your CSS -->
    <link rel="stylesheet" href="~/css/staff.css" />
</head>

<body>
    <div class="d-flex">

        <div class="bg-white border-end vh-100 p-3" style="width: 250px;">

            <h5 class="fw-bold mb-4 px-2">
                <i class="bi bi-recycle text-success"></i> E-Waste
            </h5>

            <ul class="nav flex-column">

                <li class="nav-item mb-3">
                    <a class="nav-link text-dark shadow-sm rounded p-2 sidebar-link" href="/User/Dashboard">
                        <i class="bi bi-speedometer2 me-2 text-success"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-dark shadow-sm rounded p-2 sidebar-link" href="/User/Submit">
                        <i class="bi bi-box me-2 text-success"></i> Submit E-Waste
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-dark shadow-sm rounded p-2 sidebar-link" href="/User/MySubmission">
                        <i class="bi bi-truck me-2 text-success"></i> My Submissions
                    </a>
                </li>
                <li class="nav-item mt-4">
                    <a class="nav-link text-danger shadow-sm rounded p-2 logout-link" href="/Account/Login">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </a>
                </li>

            </ul>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1">

            <!-- Page Content -->
            <div class="p-4 bg-light min-vh-100">
                @RenderBody()
            </div>

        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>