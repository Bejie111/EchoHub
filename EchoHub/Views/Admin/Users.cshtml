@model List<EchoHub.Models.User>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="~/css/Admin.css" />

<div class="submit-header">
    <h2>User Management</h2>
    <p>Manage system users and their roles.</p>
</div>

<div class="section-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="section-title mb-0">All Users</span>
        <a href="/Admin/CreateUser" class="btn-add">
            <i class="bi bi-plus"></i> Add User
        </a>
    </div>

    <!-- Search -->
    <form method="get" asp-action="Users" class="search-form mb-3">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search by name or email..." />
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Joined</th>
                    <th>Submissions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        string roleClass = user.Role?.ToLower() switch
                        {
                            "admin" => "role-admin",
                            "staff" => "role-staff",
                            _       => "role-user"
                        };

                        <tr>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="role-badge @roleClass">@user.Role</span>
                            </td>
                            <td>@user.Id</td>
                            <td>0</td>
                            <td>
                                <div class="action-btns">
                                    <a href="/Admin/EditUser/@user.Id" class="btn-edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="/Admin/DeleteUser/@user.Id"
                                       class="btn-delete"
                                       onclick="return confirm('Are you sure you want to delete this user?')">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center empty-state">
                            <i class="bi bi-people"></i>
                            <p>No users found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <p class="showing-count">Showing @Model.Count() of @Model.Count() users</p>
    }
</div>

