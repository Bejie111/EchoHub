@model EchoHub.Models.EwasteItem

@{
    ViewData["Title"] = "View E-Waste Item";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="header-container shadow-sm mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-circle shadow-sm" style="background-color: #27ae60;">
                <i class="bi bi-eye fs-4 text-white"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark mb-0">View E-Waste Item</h2>
                <p class="text-muted mb-0 small"><i class="bi bi-info-circle me-1"></i> Review the full details and condition of the submitted item.</p>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4 border-end">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="~/uploads/@Model.Image"
                         class="img-fluid rounded-3 shadow-sm"
                         style="max-height: 450px; object-fit: contain;"
                         alt="Item Image" />
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="bi bi-image-fill display-1"></i>
                        <p class="mt-2 fw-bold">No Image Available</p>
                    </div>
                }
            </div>

            <div class="col-md-7">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <h4 class="fw-bold text-dark mb-0">Item Specifications</h4>
                        <span class="badge @(Model.Status == "Pending" ? "bg-warning-subtle text-warning border-warning-subtle" : "bg-success-subtle text-success border-success-subtle") rounded-pill px-3 py-2 border">
                            @Model.Status
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">Item Name</label>
                            <p class="form-control-plaintext border-bottom pb-2 fw-semibold">@Model.Item_Name</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">Category</label>
                            <p class="form-control-plaintext border-bottom pb-2 fw-semibold">@Model.Category</p>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold text-uppercase">Description</label>
                            <div class="bg-light p-3 rounded-3 text-muted" style="min-height: 100px;">
                                @Model.Description
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold text-uppercase">Pickup Address</label>
                            <p class="form-control-plaintext border-bottom pb-2 fw-semibold"><i class="bi bi-geo-alt text-success me-2"></i>@Model.Address</p>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold text-uppercase">Submitted By</label>
                            <p class="form-control-plaintext pb-2 fw-semibold">@Model.User?.Name</p>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted small fw-bold text-uppercase">Phone Number</label>
                        <p class="form-control-plaintext pb-2 fw-semibold">@Model.User?.PhoneNumber</p>
                    </div>
                </div>

                    <div class="mt-5 pt-3 border-top">
                        <a asp-action="Manage" class="btn btn-outline-secondary px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-2"></i>Back
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>