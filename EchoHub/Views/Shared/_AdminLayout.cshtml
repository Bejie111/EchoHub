<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Admin Panel</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/Admin.css" />
</head>
<body>
    <div class="d-flex">

        <div class="bg-white border-end vh-100 p-3" style="width: 250px;">

            <h5 class="fw-bold mb-4 px-2">
                <i class="bi bi-recycle text-success"></i> E-Waste
            </h5>

            <ul class="nav flex-column">

                <li class="nav-item mb-3">
                    <a class="nav-link text-dark shadow-sm rounded p-2 sidebar-link" href="/Admin/Dashboard">
                        <i class="bi bi-speedometer2 me-2 text-success"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-dark shadow-sm rounded p-2 sidebar-link" href="/Admin/Users">
                        <i class="bi bi-box me-2 text-success"></i> User Management
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-dark shadow-sm rounded p-2 sidebar-link" href="/Category/Index">
                        <i class="bi bi-truck me-2 text-success"></i> Category Management
                    </a>
                </li>

                <li class="nav-item mb-3">
                    <a class="nav-link text-dark shadow-sm rounded p-2 sidebar-link" href="/Reports/Reports">
                        <i class="bi bi-arrow-repeat me-2 text-success"></i> Reports
                    </a>
                </li>
            </ul>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1">

            <!-- Page Content -->
            <div class="p-4 bg-light min-vh-100">
                @RenderBody()
            </div>

        </div>

    </div>

    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>