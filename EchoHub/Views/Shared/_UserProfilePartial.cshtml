@model EchoHub.Models.User

<div class="d-flex justify-content-between align-items-center px-3 py-2 bg-white shadow-sm rounded-3 mb-4">

    <!-- LEFT SIDE (Optional Title / Branding) -->
    <div>
        <h5 class="mb-0 fw-bold text-dark"></h5>
    </div>
    <!-- RIGHT SIDE (PROFILE DROPDOWN) -->
    <div class="dropdown">

        <a class="d-flex align-items-center text-decoration-none dropdown-toggle"
           href="#"
           id="userDropdown"
           data-bs-toggle="dropdown"
           aria-expanded="false">

            <!-- PROFILE IMAGE -->
            <img src="@(string.IsNullOrEmpty(Model.ProfilePicture)
                        ? Url.Content("~/uploads/default.png")
                        : Url.Content("~/uploads/" + Model.ProfilePicture))"
                 class="rounded-circle shadow-sm"
                 width="40" height="40"
                 style="object-fit: cover; border: 2px solid #27ae60;" />

            <span class="ms-2 fw-semibold text-dark">
                @Model.Name
            </span>

        </a>

        <!-- DROPDOWN MENU -->
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">

            <li>
                <a class="dropdown-item" href="/User/Profile">
                    <i class="bi bi-person-gear me-2"></i> Edit Profile
                </a>
            </li>

            <li>
                <a class="dropdown-item" href="/User/ChangePassword">
                    <i class="bi bi-lock me-2"></i> Change Password
                </a>
            </li>

            <li><hr class="dropdown-divider"></li>

            <li>
                <a class="dropdown-item text-danger" href="/Account/Login">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </li>

        </ul>

    </div>

</div>