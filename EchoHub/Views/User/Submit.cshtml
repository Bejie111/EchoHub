
@{
    ViewData["Title"] = "Submit";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@model EchoHub.Models.EwasteItem

<div class="container-box">

    <h2>Submit E-Waste</h2>
    <p>Fill the details of your e-waste item for proper disposal.</p>

    <form method="post" enctype="multipart/form-data">

        <label>Item Name</label>
        <input type="text" name="Item_Name" required />

        <label>Category</label>
        <!-- di pa ka function ang submit kay need siya mo select option and make sure naa siyay option-->
        <!-- Need oF OPTION so that the user can select what kind type or what it belong to-->
        <select name="Category" required>
            <option value="">-- Select Category --</option>

            @foreach (var cat in ViewBag.Categories)
            {
                <option value="@cat.Name">
                    @cat.Name
                </option>
            }
        </select>

        <label>Address</label>
        <input type="text" name="Address" required/>

        <label>Description</label>
        <textarea name="Description"></textarea>

        <label>Upload Image</label>
        <input type="file" name="file" />

        <button type="submit">Submit</button>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-3 px-4 py-2">
            Cancel
        </a>

    </form>

</div>