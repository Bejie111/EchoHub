@model IEnumerable<EchoHub.Models.EwasteItem>

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<link rel="stylesheet" href="~/css/staffdashboard.css" />

<div class="container mt-4">

    <h2 class="mb-1"> Staff Dashboard</h2>
    <p class="text-muted">Manage e-waste collection and recycling operation'</p>

    <!-- Cards -->
    <div class="row g-3 mt-3">

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Collected Items</h6>
                    <h3>@ViewBag.TotalSubmission</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Items for Recycling</h6>
                    <h3>@ViewBag.Recycled</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Items Disposed</h6>
                    <h3>@ViewBag.Pending</h3>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card mt-4 shadow-sm border-0">
            <div class="card-body">
                <h6 class="mb-3 fw-bold">Quick Actions</h6>

                <a href="/Staff/Manage" class="btn btn-success btn-sm me-2">
                    Manage E-Waste
                </a>

                <a href="/Collection/Collect" class="btn btn-outline-secondary btn-sm me-2">
                    View Collections
                </a>

                <a href="/Recycling/Dashboard" class="btn btn-outline-secondary btn-sm">
                    Recycling Tracking
                </a>
            </div>
        </div>
        <!-- Recent Activity -->
        <div class="card mt-4 shadow-sm border-0">
            <div class="card-body">

                <h6 class="fw-bold mb-3">Recent Activity</h6>

                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model.Take(5))
                    {
                        var statusClass = item.Status?.ToLower() switch
                        {
                                    "recycled" => "success",
                                    "collected" => "primary",
                                    "pending" => "warning",
                                    "disposed" => "danger",
                            _ => "secondary"
                        };

                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">

                            <div>
                                <span class="badge bg-@statusClass me-2">
                                    @item.Status
                                </span>

                                <span class="fw-semibold">@item.Item_Name</span><br />
                                <small class="text-muted">Submitted item</small>
                            </div>

                            <small class="text-muted">
                                @item.DateSubmitted.ToString("MMM dd, yyyy")
                            </small>

                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No recent activity.</p>
                }

            </div>
        </div>
