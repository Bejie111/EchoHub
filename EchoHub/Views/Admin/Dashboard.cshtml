@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var percent = ViewBag.Percent ?? 0;
}
<!--For the Header-->
<div class="container-fluid py-4 bg-light min-vh-100">

    <div class="header-container mb-4 p-4 rounded-4 shadow-sm position-relative overflow-hidden"
         style="background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%); border: 1px solid #e2e8f0;">

        <i class="bi bi-recycle position-absolute text-success opacity-10"
           style="font-size: 8rem; right: -20px; top: -20px; transform: rotate(15deg); pointer-events: none;"></i>

        <div class="position-relative">
            <div class="d-flex align-items-center gap-3">
                <div class="shadow-sm" style="background: #27ae60; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-speedometer2 text-white fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.5px;">Admin Dashboard</h2>
                    <p class="text-muted mb-0 small d-flex align-items-center">
                        <i class="bi bi-info-circle me-1"></i> System overview and real-time analytics for EchoHub.
                    </p>
                </div>
            </div>
        </div>
    </div>

<!--Card For the Total Users-->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-primary h-100">
                <div class="stat-info">
                    <span class="text-muted small fw-bold d-block mb-1">Total Users</span>
                    <h3 class="fw-bold mb-1">@ViewBag.TotalUsers</h3>
                    <span class="text-success small fw-semibold">
                    </span>
                </div>
            </div>
        </div>

<!--Card for the Total Items-->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-success h-100">
                <div class="stat-info">
                    <span class="text-muted small fw-bold d-block mb-1">Total E-Waste Items</span>
                    <h3 class="fw-bold mb-1">@ViewBag.TotalItems</h3>
                    <span class="text-success small fw-semibold">
                    </span>
                </div>
            </div>
        </div>

<!--Card for the Total Recycled Items-->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-info h-100">
                <div class="stat-info">
                    <span class="text-muted small fw-bold d-block mb-1">Items Recycled</span>
                    <h3 class="fw-bold mb-1">@ViewBag.TotalRecycled</h3>
                    <span class="text-info small fw-semibold">
                    </span>
                </div>
            </div>
        </div>
<!--Card for the Total Disposed Items-->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-danger h-100">
                <div class="stat-info">
                    <span class="text-muted small fw-bold d-block mb-1">Items Disposed</span>
                    <h3 class="fw-bold mb-1">@ViewBag.TotalDisposed</h3>
                    <span class="text-danger small fw-semibold">
                    </span>
                </div>
            </div>
        </div>
    </div>
    <!--STATS-->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Monthly Submissions Trend</h5>
                <canvas id="lineChart" style="max-height: 300px;"></canvas>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">E-Waste by Category</h5>
                <canvas id="pieChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Recycling Performance</h5>
                <canvas id="barChart" style="max-height: 300px;"></canvas>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Recent User Registrations</h5>
                <div class="user-list">
                    @if (ViewBag.RecentUsers != null)
                    {
                        foreach (var user in ViewBag.RecentUsers)
                        {
                            <div class="d-flex align-items-center p-2 mb-2 border-bottom border-light">
                                <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div>
                                    <strong class="d-block text-dark small">@user.Name</strong>
                                    <span class="text-muted" style="font-size: 0.75rem;">@user.Email (@user.Role)</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-person-x text-muted fs-2"></i>
                            <p class="text-muted mt-2">No recent registrations.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const submissions = @Html.Raw(ViewBag.MonthlySubmissions ?? "[0,0,0,0,0,0]");
        const recycled = @Html.Raw(ViewBag.MonthlyRecycled ?? "[0,0,0,0,0,0]");
        const disposed = @Html.Raw(ViewBag.MonthlyDisposed ?? "[0,0,0,0,0,0]");

        // LINE CHART for Monthly Submissions, Recycled, and Disposed
        new Chart(document.getElementById('lineChart'), {
            type: 'line',
            data: {
                labels: ['Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'],
                datasets: [
                    { label: 'Submissions', data: submissions, borderColor: '#3b82f6', tension: 0.3, fill: false },
                    { label: 'Recycled', data: recycled, borderColor: '#22c55e', tension: 0.3, fill: false },
                    { label: 'Disposed', data: disposed, borderColor: '#ef4444', tension: 0.3, fill: false }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        // PIE CHART for E-Waste by Category
        new Chart(document.getElementById('pieChart'), {
            type: 'pie',
            data: {
                labels: @Html.Raw(ViewBag.CategoryLabels ?? "['Laptops','Phones','Others']"),
                datasets: [{
                    data: @Html.Raw(ViewBag.CategoryData ?? "[30,20,50]"),
                    backgroundColor: ['#22c55e', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6']
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        // BAR CHART for Recycling Performance
        new Chart(document.getElementById('barChart'), {
            type: 'bar',
            data: {
                labels: ['Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'],
                datasets: [
                    { label: 'Recycled', data: recycled, backgroundColor: '#22c55e' },
                    { label: 'Disposed', data: disposed, backgroundColor: '#ef4444' }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
    </script>
}