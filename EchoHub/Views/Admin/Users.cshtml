@model List<EchoHub.Models.User>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="~/css/Admin.css" />

<div class="container-fluid py-4 bg-light min-vh-100">

    <div class="header-container mb-4 p-4 rounded-4 shadow-sm position-relative overflow-hidden"
         style="background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%); border: 1px solid #e2e8f0;">

        <i class="bi bi-people position-absolute text-success opacity-10"
           style="font-size: 8rem; right: -20px; top: -20px; transform: rotate(15deg); pointer-events: none;"></i>

        <div class="position-relative d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="shadow-sm" style="background: #27ae60; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-person-gear text-white fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.5px;">User Management</h2>
                    <p class="text-muted mb-0 small d-flex align-items-center">
                        <i class="bi bi-info-circle me-1"></i> Manage system users, roles, and platform permissions.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <h5 class="fw-bold text-dark mb-0">All Registered Users</h5>

            <form method="get" asp-action="Users" class="d-flex gap-2">
                <div class="input-group" style="max-width: 300px;">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control border-start-0 rounded-end-3 shadow-none"
                           placeholder="Search users..." />
                </div>
                <button type="submit" class="btn btn-dark rounded-3 px-3">Search</button>
            </form>
        </div>

     <!--USERS TABLE-->
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr class="text-secondary small uppercase fw-bold">
                        <th class="border-0 ps-3">Name</th>
                        <th class="border-0">Email</th>
                        <th class="border-0">Role</th>
                        <th class="border-0">Joined</th>
                        <th class="border-0 text-center">Submissions</th>
                        <th class="border-0 text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            string badgeClass = user.Role?.ToLower() switch
                            {
                                            "admin" => "bg-danger",
                                            "staff" => "bg-primary",
                                _ => "bg-success"
                            };

                            <tr>
                                <td class="ps-3 fw-semibold text-dark">@user.Name</td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    <span class="badge @badgeClass bg-opacity-10 text-@badgeClass.Replace("bg-", "") px-3 py-2 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-center">
                                    @{
                                        var counts = ViewBag.SubmissionCounts as Dictionary<int, int>;
                                        var total = counts != null && counts.ContainsKey(user.Id) ? counts[user.Id] : 0;
                                    }
                                    <span class="badge rounded-circle bg-light text-dark border p-2 shadow-sm" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                        @total
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="/Admin/EditUser/@user.Id" class="btn btn-outline-primary btn-sm rounded-3 px-3">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <a href="/Admin/DeleteUser/@user.Id" class="btn btn-outline-danger btn-sm rounded-3 px-3"
                                           onclick="return confirm('Are you sure you want to delete this user?')">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 opacity-25"></i>
                                <p class="mb-0">No users match your search criteria.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="mt-3 border-top pt-3 d-flex justify-content-between align-items-center">
                <p class="text-muted small mb-0">Showing @Model.Count() entries</p>
            </div>
        }
    </div>
</div>