@model EchoHub.Models.User

<div class="container-fluid py-4 bg-light min-vh-100">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <!-- HEADER CARD (same style as dashboard) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">

                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Edit Profile</h4>
                        <small class="text-muted">Update your personal information</small>
                    </div>

                    <i class="bi bi-person-gear text-success" style="font-size: 2rem;"></i>

                </div>
            </div>
            <!-- MAIN FORM CARD -->
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <form asp-action="Update" method="post" enctype="multipart/form-data">

                        <input type="hidden" asp-for="Id" />

                        <!-- PROFILE IMAGE -->
                        <div class="text-center mb-4">

                            <img id="previewImage"
                                 src="@(string.IsNullOrEmpty(Model.ProfilePicture)
                                                                                                     ? Url.Content("~/images/default.png")
                                                                                                     : Url.Content("~/uploads/" + Model.ProfilePicture))"
                                 class="rounded-circle shadow"
                                 width="120"
                                 height="120"
                                 style="object-fit: cover; border: 3px solid #27ae60;" />

                            <div class="mt-3">

                                <input type="file"
                                       name="file"
                                       class="form-control form-control-sm w-50 mx-auto"
                                       onchange="previewFile(event)" />

                                <a href="/User/RemovePicture/@Model.Id"
                                       class="btn btn-outline-danger btn-sm mt-2 rounded-pill px-3">
                                    Remove Picture
                                </a>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <!-- FORM FIELDS -->
                        <div class="row g-3">

                            <!-- NAME -->
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Name</label>
                                <input asp-for="Name" class="form-control shadow-sm rounded-3" />
                            </div>

                            <!-- EMAIL -->
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Email</label>
                                <input asp-for="Email" class="form-control shadow-sm rounded-3" />
                            </div>

                            <!-- PHONE -->
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Phone</label>
                                <input asp-for="PhoneNumber" class="form-control shadow-sm rounded-3" />
                            </div>

                            <!-- ROLE -->
                            <div class="col-md-12">
                                <label class="form-label text-muted small">Role</label>
                                <input asp-for="Role"
                                       class="form-control shadow-sm rounded-3 bg-light"
                                       readonly />
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-4">
                            
                            <button class="btn btn-success w-100 rounded-pill shadow-sm">
                                Save Changes
                            </button>

                            @{
                                var role = Context.Session.GetString("Role");                               
                            }

                            @if (role == "User")
                            {
                                <a href="/User/Dashboard" class="btn btn-outline-secondary px-4 rounded-pill">
                                    Cancel
                                </a>
                            }
                            else if (role == "Admin")
                            {
                                <a href="/Admin/Dashboard" class="btn btn-outline-secondary px-4 rounded-pill">
                                    Cancel
                                </a>
                            }
                            else
                            {
                                <a href="/Staff/Dashboard" class="btn btn-outline-secondary px-4 rounded-pill">
                                    Cancel
                                </a>
                            }

                        </div>
                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
@section Scripts {
    <script>
        function previewFile(event) {
            const input = event.target;
            const file = input.files[0];

            if (!file) return;

            const reader = new FileReader();

            reader.onload = function (e) {
                document.getElementById("previewImage").src = e.target.result;
            };

            reader.readAsDataURL(file);
        }
    </script>
}