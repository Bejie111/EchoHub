@model EchoHub.Models.Collection

@{
    ViewData["Title"] = "Assign Collection";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}
<div class="container-fluid py-3">
    @await Html.PartialAsync("_UserProfilePartial", (EchoHub.Models.User)ViewBag.User)
<!--HEADER-->
<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="header-container mb-4 p-4 rounded-4 shadow-sm position-relative overflow-hidden"
         style="background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%); border: 1px solid #e2e8f0;">

        <i class="bi bi-shield-check position-absolute text-success opacity-10"
           style="font-size: 8rem; right: -20px; top: -20px; transform: rotate(15deg); pointer-events: none;"></i>

        <div class="position-relative">
            <div class="d-flex align-items-center gap-3">
                <div class="shadow-sm" style="background: #27ae60; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-clipboard-data text-white fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.5px;">Schedule Collection</h2>
                    <p class="text-muted mb-0 small d-flex align-items-center">
                        <i class="bi bi-info-circle me-1"></i> Schedule pickup for the selected e-waste item.
                    </p>
                </div>
            </div>
        </div>
    </div>

<!--ASSIGN COLLECTION-->
    <div class="row">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom rounded-top-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-success"></i>Collection Details</h5>
                </div>

                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <form asp-action="Assign" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="EwasteId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Item Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-box-seam"></i></span>
                                <input type="text"
                                       class="form-control bg-light border-start-0"
                                       value="@ViewBag.ItemName"
                                       readonly
                                       style="cursor: not-allowed;" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ScheduleDate" class="form-label fw-bold text-muted small text-uppercase">Schedule Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar-event text-success"></i></span>
                                <input asp-for="ScheduleDate"
                                       type="date"
                                       class="form-control border-start-0 shadow-none" />
                            </div>
                            <span asp-validation-for="ScheduleDate" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-green shadow-sm px-4 rounded-pill">
                                <i class="bi bi-check-circle me-2"></i> Save Schedule
                            </button>

                            <a asp-action="Collect" class="btn btn-outline-secondary px-4 rounded-pill">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 bg-success-subtle shadow-sm rounded-4 p-4 h-100">
                <h6 class="fw-bold text-success"><i class="bi bi-lightbulb me-2"></i>Quick Note</h6>
                <p class="text-muted small mb-0">Ensure the selected date is convenient for the user. Once scheduled, the item will appear in the "Scheduled Task" list for staff tracking.</p>
            </div>
        </div>
    </div>
</div
</div>