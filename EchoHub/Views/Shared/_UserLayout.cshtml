
@{
    ViewData["Title"] = "_UserLayout";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/user.css" />
</head>
<body>

    <div class="layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="logo">♻ E-Waste</div>

            <ul>
                <li><a href="/User/Dashboard">Dashboard</a></li>
                <li><a href="/User/Submit">Submit E-Waste</a></li>
                <li><a href="/User/MySubmission">My Submission</a></li>
                <li><a href="/Account/Login">Logout</a></>
            </ul>

            <div class="bottom-user">
                @Context.Session.GetString("Name")
            </div>

        </aside>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>

    </div>

</body>
</html>